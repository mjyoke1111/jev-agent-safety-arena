# Vercel AI Gateway. Create at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
JEV_MODEL=typesafe-ai/jev
# Cheap planning/baseline model available through the same gateway.
PLANNER_MODEL=openai/gpt-4.1-nano
BASELINE_MODEL=openai/gpt-4.1-nano
# Optional provider prices in USD per 1M tokens. Set to current prices for cost telemetry.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
PLANNER_INPUT_USD_PER_MILLION=
PLANNER_OUTPUT_USD_PER_MILLION=
# Required only for the protected hosted evaluation endpoint.
ARENA_RUN_SECRET=
# Optional direct Jev provider key. When set, Jev bypasses Gateway; planner/baseline remain on Gateway.
TYPESAFE_API_KEY=
